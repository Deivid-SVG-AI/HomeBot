# Secretos de Búho. Nunca los subas a git ni los pegues en un chat.
# En la Pi el archivo real es /opt/buho/.env (dueño root, permisos 600; lo ajusta install_pi.sh).

# Te lo da @BotFather al crear el bot.
TELEGRAM_BOT_TOKEN=

# Déjalo vacío la primera vez: manda /start al bot y te responderá con tu chat id.
TELEGRAM_CHAT_ID=

# Solo en la PC: 1 = los mensajes programados se imprimen en consola en vez de enviarse.
# BUHO_DRY_RUN=1
